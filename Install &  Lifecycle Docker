Container Lifecycle:

#for Runing Container Interactive mode on centos:
docker run -it centos:7 /bin/bash

#for show container id on detach mode:
docker run -itd centos:7 /bin/bash

#for Interactive and name on centos:
docker run -it --name fano centos:7 top

#Detaching from containers
ctrl+p+q

#Listing containers
docker ps -a

#Reattaching to standard input, output , errors containers:
docker attach CONTAINER-ID or NAME

#Executing commands inside running containers:
docker exec CONTAINER-IR OR NAME
*example: docker exec c1 ls/var

#Enable live-restore
vim /etc/docker/deamon.json
{
"live-restore": true
}

systemctl reload docker
systemctl status docker: active (running)
docker info :Live Restore Enabled: true




