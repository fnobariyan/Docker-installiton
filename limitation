##Add limitation on resource host

#MEMORY
docker run -itd --name c1 -m 500M centos:7 

#SWAP
docker run -itd --name c1 -m 400M --memory-swap 1G centos:7 (--memory-swap 1G means memory+swap=1G , swap=600)
docker run -itd --name c2 -m 400M --memory-swap -1 centos:7 (--memory-swap -1 means memory+swap=NO LIMIT)

#CPU
docker run -itd --name c2 --cpuset-cpus="0" centos:7 (--cpuset-cpus="0" means allowed to used node1)
docker run -itd --name c3 --cpuset-cpus="0,1" centos:7 (--cpuset-cpus="0" means allowed to used node1 and node2)
docker run -itd --name c4 --cpuset-cpus="0-4" centos:7 (--cpuset-cpus="0" means allowed to used node1,node2,node3 and node4)

#DISK
docker run -itd --name c5 --storage-opt size=5G centos:7

